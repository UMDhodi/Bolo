{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["email", "phone"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "issues": {
      ".read": true,
      "$issueId": {
        ".write": "auth != null && (!data.exists() || data.child('reporterUid').val() === auth.uid || data.child('userId').val() === auth.uid)"
      }
    },
    "waitlist": {
      ".read": false,
      "$entry": {
        ".write": "!data.exists() && newData.hasChildren(['email', 'createdAt'])"
      }
    }
  }
}
