# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: https://console.firebase.google.com → Project Settings → Your apps

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# MSG91 Phone OTP Configuration
# Get these from: https://control.msg91.com → API Keys & OTP Templates
VITE_MSG91_AUTH_KEY=
VITE_MSG91_TEMPLATE_ID=
