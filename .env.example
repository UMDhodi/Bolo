# ── Supabase (Authentication & PostgreSQL Database) ─────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Server-side only (for backend queries / health check / migrations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
# Optional Supabase connection pooler string
SUPABASE_POOLER_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Upstash Redis (Server-Side Rate Limiting & Distributed Cache) ────────────
# Get these from: https://console.upstash.com → Redis → Details → REST API
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ── Cloudflare R2 (Object Storage for Avatars & Civic Media) ─────────────────
# Get these from: Cloudflare Dashboard → R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_api_token_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_api_token_secret_access_key
R2_BUCKET=bolo-media
# Optional public domain or r2.dev domain for serving media
R2_PUBLIC_URL=https://media.bolo.gov.in

# ── Cloudflare Turnstile (CAPTCHA & Bot Protection) ──────────────────────────
# Get these from: Cloudflare Dashboard → Turnstile → Add Widget
# Site Key is public, safe for frontend
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxx
# Secret Key is server-side only
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── MSG91 Phone OTP (Optional Indian SMS Gateway) ────────────────────────────
# Get these from: https://control.msg91.com → API Keys & OTP Templates
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_TEMPLATE_ID=

# ── GitHub Actions Health Check Cron Secret ──────────────────────────────────
# Set in GitHub Repo → Settings → Secrets & Variables → Actions → APP_URL
# APP_URL=https://bolo-civic-connect.vercel.app
